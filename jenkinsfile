pipeline {
  agent any

  tools {
    maven 'Maven3'
  }

  parameters {
    choice(
      name: 'EXECUTION_TYPE',
      choices: ['Regression', 'Smoke'],
      description: 'Select the type of execution'
    )
  }

  stages {
    stage('Build') {
      steps {
        sh 'mvn clean compile'
      }
    }

    stage('Test') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'github_username', passwordVariable: 'PASSWORD', usernameVariable: 'USERNAME')]) 
        
        {
          sh "mvn -Dgroups=${params.EXECUTION_TYPE} test"
         sh '''
          echo System.getProperty("user.name")
          echo System.getProperty("user.home")
          '''
        }
      }
    }

  }

  post {
    always {
      junit '**/target/surefire-reports/*.xml'
    }
  }
}