pipeline {
    agent any

    tools {
        maven 'Maven3'
    }

    parameters {
        choice(
            name: 'EXECUTION_TYPE',
            choices: ['REGRESSION', 'SMOKE'],
            description: 'Select the type of execution'
        )
    }

    stages {
        stage('Build') {
            steps {
                sh 'mvn clean compile'
            }
        }

        stage('Regression Test') {
            when {
                expression { params.EXECUTION_TYPE == 'REGRESSION' }
            }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    sh 'mvn -Dsurefire.suitexmlfiles=**/RegressionTest.xml test'
                }
            }
        }

        stage('Smoke Test') {
            when {
                expression { params.EXECUTION_TYPE == 'SMOKE' }
            }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    sh 'mvn -Dsurefire.suitexmlfiles=**/SmokeTest.xml test'
                }
            }
        }
    }

    post {
        always {
            junit '**/target/surefire-reports/*.xml'
        }
    }
}
