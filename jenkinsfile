pipeline {
  agent any

  tools {
    maven 'Maven3'
  }

  parameters {
    choice(
      name: 'EXECUTION_TYPE',
      choices: ['Regression', 'Smoke'],
      description: 'Select the type of execution'
    )
  }

  stages {
    stage('Build') {
      steps {
        sh 'mvn -B clean compile'
      }
    }

    stage('Test') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'github_username', usernameVariable: 'USERNAME', passwordVariable: 'PASSWORD')]) {
          sh "echo 'Using credentials: $USERNAME / $PASSWORD'"
          sh "mvn -B -Dgroups=${params.EXECUTION_TYPE} test"
        }
       
       
      }
    }

  }

  post {
    always {
      junit '**/target/surefire-reports/*.xml'
    }
  }
}
